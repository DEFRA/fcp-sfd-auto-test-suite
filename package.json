{
  "name": "fcp-sfd-auto-test-suite",
  "version": "0.0.0",
  "type": "module",
  "description": "",
  "engines": {
    "node": ">=22.13.1",
    "npm": ">=11.10.0"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "aliases": {
    "~": ".",
    "page-objects": "test/page-objects",
    "components": "test/components"
  },
  "scripts": {
    "clean": "rm -rf allure-results && rm -rf allure-report",
    "test": "npm run clean && cucumber-js --tags \"not @accessibility\"",
    "test:smoke": "npm run clean && cucumber-js --tags '@smoke'",
    "test:a11y": "npm run clean && node bin/run-a11y.js",
    "test:tag": "npm run clean && cucumber-js --tags \"%TAG%\"",
    "test:cdp": "npm run clean && cucumber-js --config playwright.cdp.config.js",
    "report": "allure generate allure-results --single-file --clean",
    "report:publish": "npm run report && ./bin/publish-tests.sh",
    "fix:test-users": "node bin/fix-test-users.js",
    "find:test-users": "node bin/find-test-users.js",
    "format": "prettier --write '**/*.{js,md,json}'",
    "format:check": "prettier --check '**/*.{js,md,json}'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "git:pre-commit-hook": "npm run format:check && npm run lint",
    "postinstall": "npm run setup:husky",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "check:synthetic-ids": "sfd-id-check --staged"
  },
  "dependencies": {
    "undici": "8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cucumber/cucumber": "12.9.0",
    "@faker-js/faker": "10.4.0",
    "@playwright/test": "1.60.0",
    "@types/node": "24.1.0",
    "allure-commandline": "2.42.0",
    "allure-cucumberjs": "3.9.0",
    "allure-playwright": "3.9.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-prettier": "5.5.5",
    "fcp-sfd-core": "github:DEFRA/fcp-sfd-core#95f58ade56b2d0dd0f15bdcba6a5f37a54bcc939",
    "husky": "9.1.7",
    "playwright": "1.60.0",
    "prettier": "3.8.3"
  }
}
